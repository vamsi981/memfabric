# The fabric is model-agnostic. Auto-detection order:
#   1. MEMFABRIC_LLM spec        (provider[:model])
#   2. ANTHROPIC_API_KEY             -> Anthropic (claude-opus-5)
#   3. OPENAI_API_KEY                -> OpenAI (gpt-5-mini)
#   4. none of the above             -> heuristic mode (no LLM extraction)
#
# Spec examples:
#   MEMFABRIC_LLM=anthropic:claude-opus-5
#   MEMFABRIC_LLM=openai:gpt-5-mini
#   MEMFABRIC_LLM=ollama:llama3.1        # local, no API key needed
#
# For any other OpenAI-compatible endpoint (Groq, OpenRouter, vLLM, ...),
# construct OpenAICompatibleLLM(base_url=..., model=...) in code.

# MEMFABRIC_LLM=ollama:llama3.1
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
